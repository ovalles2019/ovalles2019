# --- LLM (Claude via LangChain) ---
ANTHROPIC_API_KEY=
JOB_INTEL_MODEL=claude-opus-5-5
JOB_INTEL_EFFORT=medium          # low | medium | high | xhigh | max
JOB_INTEL_FIT_THRESHOLD=60        # postings scoring below this skip tailoring

# --- LangSmith: dev-time tracing, datasets, experiments ---
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=job-intel

# --- Langfuse: production tracing, cost dashboards, user feedback ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com   # or your self-hosted URL
